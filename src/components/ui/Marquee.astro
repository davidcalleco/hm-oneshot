---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<hm-marquee class="block overflow-hidden border-y border-line bg-cream py-4">
  <div data-marquee-track class="flex w-max" aria-hidden="true">
    {
      Array.from({ length: 2 }).map(() => (
        <ul class="flex shrink-0 items-center">
          {items.map((item) => (
            <li class="flex items-center">
              <span class="type-label px-7 whitespace-nowrap text-ink">{item}</span>
              <span class="size-[5px] rounded-full bg-signal" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
  <p class="sr-only">Capabilities: {items.join(", ")}.</p>
</hm-marquee>

<script>
  import "@/scripts/marquee";
</script>
