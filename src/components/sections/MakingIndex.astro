---
import type { whatWeMake as whatWeMakeContent } from "@/data";
import Reveal from "@/components/ui/Reveal.astro";

interface Props {
  items: typeof whatWeMakeContent;
}

const { items } = Astro.props;
---

<ol class="grid gap-x-8 gap-y-10 border-t border-line pt-10 md:grid-cols-2 lg:grid-cols-3">
  {
    items.map((item, i) => (
      <Reveal as="li" delay={Math.min(i * 0.04, 0.24)}>
        <p class="type-label text-signal">{item.index}</p>
        <h3 class="type-heading mt-3 max-w-[18ch] text-[1.25rem] md:text-[1.4rem]">{item.name}</h3>
        <p class="type-body mt-3 max-w-[38ch] text-[0.9375rem]">{item.body}</p>
      </Reveal>
    ))
  }
</ol>
