---
import type { Situation } from "@/data";
import Reveal from "@/components/ui/Reveal.astro";
import Tag from "@/components/ui/Tag.astro";

interface Props {
  situations: readonly Situation[];
  /** Full detail on the situations page; title and symptom only elsewhere. */
  detailed?: boolean;
  modeLabels?: Record<string, { name: string; href: string }>;
}

const { situations, detailed = false, modeLabels } = Astro.props;
---

<ol class="border-t border-line">
  {
    situations.map((situation, i) => (
      <Reveal as="li" delay={Math.min(i * 0.05, 0.25)} class="border-b border-line">
        <article class="grid-editorial gap-y-5 py-10 md:py-14">
          <div class="col-span-12 md:col-span-2">
            <span
              aria-hidden="true"
              class="font-display block text-[clamp(2.25rem,4vw,3.5rem)] leading-[0.85] font-medium tracking-[-0.04em] text-numeral"
            >
              {situation.index}
            </span>
          </div>

          <div class="col-span-12 md:col-span-9 md:col-start-4">
            <h3 class="type-heading max-w-[24ch]">{situation.title}</h3>
            <p class="type-body mt-5 max-w-[60ch]">{situation.symptom}</p>

            {
              detailed ? (
                <div class="mt-8 grid gap-x-8 gap-y-6 border-t border-line pt-6 md:grid-cols-2">
                  <div>
                    <h4 class="type-label text-faint">What it costs</h4>
                    <p class="type-body mt-3 max-w-[42ch] text-[0.9375rem]">{situation.cost}</p>
                  </div>
                  <div>
                    <h4 class="type-label text-faint">How we respond</h4>
                    <p class="type-body mt-3 max-w-[42ch] text-[0.9375rem]">{situation.response}</p>
                  </div>
                </div>
              ) : null
            }

            {
              detailed ? (
                <div class="mt-8 flex flex-wrap items-center gap-2">
                  {situation.capabilities.map((capability) => (
                    <Tag>{capability}</Tag>
                  ))}
                  {modeLabels?.[situation.mode] ? (
                    <a
                      href={modeLabels[situation.mode].href}
                      class="type-label link-underline ml-1 text-signal"
                    >
                      Usually starts as {modeLabels[situation.mode].name} →
                    </a>
                  ) : null}
                </div>
              ) : null
            }
          </div>
        </article>
      </Reveal>
    ))
  }
</ol>
