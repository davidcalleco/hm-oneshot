---
import type { studio as studioContent } from "@/data/content";
import Reveal from "@/components/ui/Reveal.astro";
import SectionHead from "@/components/ui/SectionHead.astro";

interface Props {
  content: typeof studioContent;
}

const { content } = Astro.props;
---

<section id="studio" class="scroll-mt-28 py-24 md:py-36">
  <div class="shell">
    <SectionHead
      index={content.index}
      label={content.label}
      statement={content.statement}
      statementClass="max-w-[17ch]"
    >
      <div class="grid-editorial mt-12 gap-y-6 md:mt-16">
        {
          content.columns.map((column, i) => (
            <Reveal
              delay={0.08 * (i + 1)}
              class={
                i === 0
                  ? "col-span-12 lg:col-span-5"
                  : "col-span-12 lg:col-span-5 lg:col-start-7"
              }
            >
              <p class="type-body">{column}</p>
            </Reveal>
          ))
        }
      </div>
    </SectionHead>

    {/* Where the studio sits — a spectrum, not a grid of cards */}
    <Reveal class="mt-20 md:mt-28">
      <div class="relative border-t border-line pt-10">
        <span
          aria-hidden="true"
          class="absolute top-0 left-0 h-px w-full bg-signal"
          style="clip-path: inset(0 25% 0 25%)"
        />
        <div class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
          {
            content.fields.map((field, i) => (
              <div class="relative">
                <span
                  aria-hidden="true"
                  class={`absolute -top-10 left-0 h-4 w-px ${i === 1 || i === 2 ? "bg-signal" : "bg-line-strong"}`}
                />
                <h3 class="type-label text-ink">{field.label}</h3>
                <p class="type-body mt-3 max-w-[30ch] text-[0.9375rem]">{field.body}</p>
              </div>
            ))
          }
        </div>
        <p class="type-label mt-10 text-faint">{content.footnote}</p>
      </div>
    </Reveal>
  </div>
</section>
